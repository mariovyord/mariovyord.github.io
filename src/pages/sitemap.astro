---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = "Sitemap — Mario Yordanov";
const description = "Overview of all pages and notes on this site.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .prose {
        max-width: 720px;
        margin: auto;
        padding: 1em;
      }
      .prose h1 {
        margin: 0 0 0.5em;
      }
      .prose h2 {
        font-size: 1.2rem;
        margin: 1.5em 0 0.5em;
      }
      .prose ul {
        list-style: none;
        padding: 0;
      }
      .prose li {
        padding: 0.4em 0;
        border-bottom: 1px solid var(--border-color);
      }
      .prose li:last-child {
        border-bottom: none;
      }
      .prose .meta {
        font-size: 0.85rem;
        color: rgb(var(--gray));
        font-family: "Roboto", sans-serif;
      }
      .section {
        margin-bottom: 2rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article class="prose">
        <h1>Sitemap</h1>
        <p><i>All pages and notes on this site.</i></p>
        <hr />

        <div class="section">
          <h2>Pages</h2>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/notes/">Notes</a></li>
            <li><a href="/playground">Playground</a></li>
            <li><a href="/colophon">Colophon</a></li>
          </ul>
        </div>

        <div class="section">
          <h2>Notes ({notes.length})</h2>
          <ul>
            {
              notes.map((note) => (
                <li>
                  <a href={`/notes/${note.slug}/`}>{note.data.title}</a>
                  <div class="meta">
                    <FormattedDate date={note.data.pubDate} />
                    {note.data.tags && note.data.tags.length > 0 && (
                      <> — {note.data.tags.map((t) => `#${t}`).join(", ")}</>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
